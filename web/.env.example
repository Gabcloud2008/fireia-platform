# Configuración de entorno de la web FIREIA.
# Copia este archivo a .env (no se sube nunca a los repos).

# Base de datos Prisma (SQLite local). La plataforma FIREIA NO la usa:
# los datos salen de src/data/mvp/*.json (ver README, sección "Capa de datos").
# Queda del andamiaje inicial del proyecto.
DATABASE_URL="file:./db/custom.db"

# --- FIREIA LIVE (Misión 016) — OPCIONALES: sin ellas la web usa el export
# estático; con ellas se activa la capa en vivo (Realtime + frescura). ---
# NEXT_PUBLIC_SUPABASE_URL="https://xpegeuamgupnxulosqlu.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<clave anon pública del proyecto>"
# Base de la API de IA en Render (proxy /api/ia/prediccion):
# FIREIA_API_BASE="https://fireia-api.onrender.com"
